.claude/*
!.claude/skills/
.claude/skills/*
!.claude/skills/post-impl-followup/
lancedb/
docs/internal/
# Generated mdBook output. `**` rather than `*` so this covers a build at any
# depth: the two books default to docs/user/book/ and docs/engine/book/, but an
# ad-hoc `mdbook build docs/user -d docs/book` lands one directory higher, which
# a single-segment glob misses. That gap left several MB of stale generated HTML
# untracked-but-committable in the working tree.
docs/**/book/
!docs/ai/
!docs/ai/**
target/
# Isolated build target used when a checkout must not share the workspace
# `target/` — concurrent builds in sibling checkouts otherwise race on the
# shared directory and can link a stale rlib. Deliberately unanchored so it
# matches at any depth: inside a linked worktree this directory is top-level
# relative to that worktree's root, so an anchored pattern would miss it and
# leave a multi-GB build tree untracked-but-committable.
target-verify/
bench-data/
examples/pipelines/output/
examples/pipelines/retract-demo/output/
examples/pipelines/per-source-ck/output/
# Scenario inputs are generated by `cargo run -p clinker-scenarios -- gen` and
# outputs are produced by running a scenario; neither is a source artifact.
# `expected/` is deliberately NOT ignored — a golden is the committed, reviewed
# statement of correct behaviour, and its diff is how a regression gets caught.
examples/scenarios/*/data/
examples/scenarios/*/output/
tests/e2e/
.playwright-mcp/
notes/

# Filesystem case-sensitivity probe files clinker writes (and cleans up) during
# test runs; they can linger if a run is interrupted.
clinker-case-probe-*.tmp

# Stray CLI output an integration test writes with a relative `path: out.csv`
# when run from the crate directory; never a source artifact.
crates/clinker/out.csv

# Local review/audit scratch trees written by ad-hoc tooling during code
# review and auditing; never source artifacts.
.audit/
.pi/
.review-scratch/
.review-tmp/
.review_scratch/
.review_tmp/
