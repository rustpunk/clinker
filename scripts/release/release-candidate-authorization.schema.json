{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "clinker.release-candidate-authorization/v1",
  "title": "Clinker release candidate authorization",
  "description": "Normative create-only pre-build human authority artifact for the locked clinker-release-policy Rust CLI. It contains only values knowable before candidate construction. The sibling digest covers the nested authorization object, while the Rust validator enforces cross-field and digest identity.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "decision_id",
    "control_id",
    "status",
    "selection",
    "approver_role_ref",
    "evidence_refs",
    "recorded_at",
    "authorization",
    "candidate_authorization_sha256"
  ],
  "properties": {
    "schema": {
      "const": "clinker.release-candidate-authorization/v1"
    },
    "decision_id": {
      "const": "release-candidate-authorization"
    },
    "control_id": {
      "const": "candidate-authorization"
    },
    "status": {
      "enum": ["authorized", "rejected", "stopped", "incomplete"]
    },
    "selection": {
      "enum": ["approve-exact-candidate", "stop-without-completion"]
    },
    "approver_role_ref": {
      "type": "string",
      "minLength": 1
    },
    "evidence_refs": {
      "$ref": "#/$defs/evidenceRefs"
    },
    "recorded_at": {
      "$ref": "#/$defs/timestamp"
    },
    "authorization": {
      "oneOf": [
        {
          "$ref": "#/$defs/authorized"
        },
        {
          "$ref": "#/$defs/nonAuthorized"
        }
      ]
    },
    "candidate_authorization_sha256": {
      "$ref": "#/$defs/digest"
    }
  },
  "$defs": {
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "pattern": "(?:Z|[+-][0-9]{2}:[0-9]{2})$"
    },
    "digest": {
      "type": "string",
      "pattern": "^[0-9a-fA-F]{64}$"
    },
    "sha": {
      "type": "string",
      "pattern": "^[0-9a-fA-F]{40}$"
    },
    "evidenceRefs": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "authorized": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "selection",
        "approver_role_ref",
        "evidence_refs",
        "recorded_at",
        "approved_at",
        "candidate_tag",
        "candidate_version",
        "source_sha",
        "publish_workflow_ref",
        "publish_workflow_ref_resolved_sha",
        "publish_workflow_sha",
        "changelog_ref",
        "inventory_ref",
        "authorized_release_maintainer_ref"
      ],
      "properties": {
        "status": {
          "const": "authorized"
        },
        "selection": {
          "const": "approve-exact-candidate"
        },
        "approver_role_ref": {
          "type": "string",
          "minLength": 1
        },
        "evidence_refs": {
          "$ref": "#/$defs/evidenceRefs"
        },
        "recorded_at": {
          "$ref": "#/$defs/timestamp"
        },
        "approved_at": {
          "$ref": "#/$defs/timestamp"
        },
        "candidate_tag": {
          "type": "string",
          "pattern": "^v(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?$"
        },
        "candidate_version": {
          "type": "string",
          "minLength": 1
        },
        "source_sha": {
          "$ref": "#/$defs/sha"
        },
        "publish_workflow_ref": {
          "type": "string",
          "minLength": 1
        },
        "publish_workflow_ref_resolved_sha": {
          "$ref": "#/$defs/sha"
        },
        "publish_workflow_sha": {
          "$ref": "#/$defs/sha"
        },
        "changelog_ref": {
          "type": "string",
          "minLength": 1
        },
        "inventory_ref": {
          "type": "string",
          "minLength": 1
        },
        "authorized_release_maintainer_ref": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "nonAuthorized": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "selection",
        "approver_role_ref",
        "evidence_refs",
        "recorded_at"
      ],
      "properties": {
        "status": {
          "enum": ["rejected", "stopped", "incomplete"]
        },
        "selection": {
          "const": "stop-without-completion"
        },
        "approver_role_ref": {
          "type": "string",
          "minLength": 1
        },
        "evidence_refs": {
          "$ref": "#/$defs/evidenceRefs"
        },
        "recorded_at": {
          "$ref": "#/$defs/timestamp"
        }
      }
    }
  }
}
